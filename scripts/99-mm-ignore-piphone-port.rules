# Tell ModemManager to ignore ttyUSB3 (USB interface 1.3) on the SIM7600G-H
# so piphone's AT driver can use it exclusively, while ModemManager keeps
# ttyUSB2 (interface 1.2) for its own AT polling / signal quality checks.
#
# Port-specific tags must be applied via SUBSYSTEMS=="usb" matching the
# exact bInterfaceNumber, on the tty device — not on the parent USB device
# (that would ignore the whole modem, not just this one port).

SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1e0e", ATTRS{idProduct}=="9001", ATTRS{bInterfaceNumber}=="03", ENV{ID_MM_PORT_IGNORE}="1"
